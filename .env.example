# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/nexussmm

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT / Session (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
COOKIE_SECRET=

# ── TOTP Encryption (must be exactly 64 hex chars)
TOTP_ENCRYPTION_KEY=

# ── Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ── Email SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NexusSMM <noreply@example.com>

# ── Razorpay (https://dashboard.razorpay.com)
# RAZORPAY_MODE: mock (dev only, no real API) | test (rzp_test_ keys) | live (rzp_live_ keys)
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cryptomus (https://app.cryptomus.com)
CRYPTOMUS_API_KEY=
CRYPTOMUS_MERCHANT_ID=

# ── USDT Wallet Addresses (your wallets for manual deposits)
USDT_WALLET_TRC20=
USDT_WALLET_ERC20=
USDT_WALLET_BEP20=

# ── NOWPayments (optional — for auto USDT)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ── Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
WORKER_MODE=false