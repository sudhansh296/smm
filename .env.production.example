# ════════════════════════════════════════════════════════════════════
# PRODUCTION environment template — manual-payment-only, HTTP-only IP launch
#
# This is the INTERIM config: no domain yet, so no HTTPS -- serving directly
# on the VPS's bare IP address over plain HTTP.
#
# How to use:
#   1. Copy this file to `.env` on the VPS (same directory as docker-compose.yml)
#   2. Fill in every value marked <FILL_ME> (DOMAIN = the VPS's bare IP for now)
#   3. Run: docker compose up -d --build
#
# When a real domain arrives later:
#   - DOMAIN/FRONTEND_URL/NEXT_PUBLIC_API_URL/API_BASE_URL -> https://yourdomain.com
#   - Remove the COOKIE_SECURE line below (or set to true)
#   - Swap nginx/templates/nexussmm.conf.template back to the HTTPS version --
#     see nginx/nexussmm-https.conf.template.future for the ready-to-use content
#   - Re-enable the certbot service: `docker compose --profile ssl up -d`
#
# The secrets below (JWT_SECRET, COOKIE_SECRET, TOTP_ENCRYPTION_KEY,
# POSTGRES_PASSWORD, REDIS_PASSWORD) were freshly generated for this file --
# safe to use as-is, or regenerate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do NOT reuse the values from your local dev .env -- those are dev-only.
# ════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────
POSTGRES_DB=nexussmm
POSTGRES_USER=nexussmm_user
POSTGRES_PASSWORD=7kULxHXxjQrAJHl3S34I3E93OVhTFk
# docker-compose overrides DATABASE_URL for the api/worker containers using the
# POSTGRES_* values above (internal Docker network hostname) -- this line is
# only used if you ever run the api outside docker-compose.
DATABASE_URL=postgresql://nexussmm_user:7kULxHXxjQrAJHl3S34I3E93OVhTFk@postgres:5432/nexussmm

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=rW6cgNG39NfP12wVpDhOooqlYbRVDZg
REDIS_URL=redis://:rW6cgNG39NfP12wVpDhOooqlYbRVDZg@redis:6379

# ── JWT / Session ────────────────────────────────────────────────
JWT_SECRET=5d1aa34435a25e7d80a3f4c7800f8ddc772389731c1637fffad81d1940c7cce4
COOKIE_SECRET=4275ffee93b71f26fffd71b0424414af22bfed22bf95e65abd9ccc640382e709

# ── TOTP Encryption (must be exactly 64 hex chars) ──────────────
TOTP_ENCRYPTION_KEY=09cacf560a41ab3165707bcb76bd62bc974aeecdfebefb54eef5375e38ec59b9

# ── Cookie security -- TEMPORARY: remove (or set to "true") once HTTPS is live ──
# Without this, secure cookies silently fail to persist over plain HTTP and
# login won't work at all.
COOKIE_SECURE=false

# ── Google OAuth (optional -- leave as "placeholder" to disable Google login) ──
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
# Once you have a domain and want Google login live, register a NEW redirect
# URI in Google Cloud Console (https://<FILL_ME: your domain>/auth/google/callback)
# and fill in real values above + update the line below to match.
GOOGLE_CALLBACK_URL=https://<FILL_ME>/auth/google/callback

# ── Email (SMTP) -- required for verification/reset emails to actually send ──
SMTP_HOST=<FILL_ME>
SMTP_PORT=587
SMTP_USER=<FILL_ME>
SMTP_PASSWORD=<FILL_ME>
SMTP_FROM="NexusSMM <noreply@<FILL_ME>>"

# ── Razorpay -- DISABLED for manual-only launch ─────────────────
# Flip to "test" or "live" later (with real credentials) once available --
# the "Pay Online" tab will reappear on the deposit page automatically.
RAZORPAY_MODE=disabled
RAZORPAY_KEY_ID=mock
RAZORPAY_KEY_SECRET=mock
RAZORPAY_WEBHOOK_SECRET=mock

# ── Cryptomus -- DISABLED for manual-only launch ────────────────
# Flip to "live" later (with real credentials) once available --
# the "Auto Payment" tab will reappear on the deposit page automatically.
CRYPTOMUS_MODE=disabled
CRYPTOMUS_API_KEY=mock
CRYPTOMUS_MERCHANT_ID=mock

# ── USDT Wallet Addresses (only used if you enable manual USDT deposits) ──
# Prefer setting these from Admin -> Settings in the UI instead -- those take
# priority over these env vars and don't need a redeploy to change.
USDT_WALLET_TRC20=
USDT_WALLET_ERC20=
USDT_WALLET_BEP20=

# ── Exchange Rate API ────────────────────────────────────────────
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# ── Application ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# For now, just the bare VPS IP (e.g. 203.0.113.5) -- no scheme, no domain yet.
DOMAIN=<FILL_ME>
ADMIN_EMAIL=<FILL_ME>
# http (not https) -- matches DOMAIN being a bare IP with no TLS cert yet.
FRONTEND_URL=http://<FILL_ME>
NEXT_PUBLIC_API_URL=http://<FILL_ME>
API_BASE_URL=http://<FILL_ME>
WORKER_MODE=false
