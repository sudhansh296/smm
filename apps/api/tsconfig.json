  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@nexussmm/db": ["../../packages/db/src/index.ts"],
      "@nexussmm/queue": ["../../packages/queue/src/index.ts"],
      "@nexussmm/types": ["../../packages/types/src/index.ts"],
