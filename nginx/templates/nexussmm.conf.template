# Interim HTTP-only config -- no domain/SSL cert yet, serving on the bare
# VPS IP. See nginx/nexussmm-https.conf.template.future for what replaces
# this once a real domain + Let's Encrypt cert are available.
server {
  listen 80;
  server_name ${DOMAIN};

  # API — all backend routes
  location ~ ^/(api|auth|user|services|orders|deposits|webhooks|admin|health) {
    proxy_pass http://api:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  # Next.js frontend
  location / {
    proxy_pass http://web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 60s;
  }
}
